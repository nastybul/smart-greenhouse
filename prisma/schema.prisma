datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// 1. Облікові записи користувачів
model User {
  id           BigInt        @id @default(autoincrement())
  email        String        @unique
  passwordHash String        @map("password_hash")
  fullName     String        @map("full_name")
  role         String        @default("OPERATOR")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz
  greenhouses  Greenhouse[]

  @@map("users")
}

// 2. Об'єкти моніторингу — Теплиці
model Greenhouse {
  id              BigInt           @id @default(autoincrement())
  userId          BigInt           @map("user_id")
  name            String
  location        String?
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  sensors         Sensor[]
  actuators       Actuator[]
  eventLogs       EventLog[]
  alerts          Alert[]

  @@map("greenhouses")
}

// 3. Датчики мікроклімату
model Sensor {
  id              BigInt           @id @default(autoincrement())
  greenhouseId    BigInt           @map("greenhouse_id")
  sensorType      String           @map("sensor_type")
  model           String?
  unit            String
  isActive        Boolean          @default(true) @map("is_active")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz
  greenhouse      Greenhouse       @relation(fields: [greenhouseId], references: [id], onDelete: Cascade)
  readings        SensorReading[]
  automationRules AutomationRule[]

  @@map("sensors")
}

// 4. Показники датчиків (Телеметрія у часі)
model SensorReading {
  id         BigInt   @id @default(autoincrement())
  sensorId   BigInt   @map("sensor_id")
  value      Decimal  @db.Decimal(8, 2)
  recordedAt DateTime @default(now()) @map("recorded_at") @db.Timestamptz
  sensor     Sensor   @relation(fields: [sensorId], references: [id], onDelete: Cascade)

  @@index([sensorId, recordedAt(sort: Desc)])
  @@map("sensor_readings")
}

// 5. Виконавчі пристрої (Актуатори: помпа, вентиляція, освітлення)
model Actuator {
  id              BigInt           @id @default(autoincrement())
  greenhouseId    BigInt           @map("greenhouse_id")
  actuatorType    String           @map("actuator_type")
  name            String
  status          String           @default("OFF")
  controlMode     String           @default("AUTO") @map("control_mode")
  updatedAt       DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  greenhouse      Greenhouse       @relation(fields: [greenhouseId], references: [id], onDelete: Cascade)
  automationRules AutomationRule[]
  eventLogs       EventLog[]

  @@map("actuators")
}

// 6. Правила автопілота
model AutomationRule {
  id                 BigInt   @id @default(autoincrement())
  actuatorId         BigInt   @map("actuator_id")
  sensorId           BigInt   @map("sensor_id")
  conditionOperator  String   @map("condition_operator")
  thresholdValue     Decimal  @map("threshold_value") @db.Decimal(8, 2)
  actionDurationSec  Int      @default(0) @map("action_duration_sec")
  isEnabled          Boolean  @default(true) @map("is_enabled")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz
  actuator           Actuator @relation(fields: [actuatorId], references: [id], onDelete: Cascade)
  sensor             Sensor   @relation(fields: [sensorId], references: [id], onDelete: Cascade)

  @@map("automation_rules")
}

// 7. Журнал системних логів та подій
model EventLog {
  id           BigInt     @id @default(autoincrement())
  greenhouseId BigInt     @map("greenhouse_id")
  actuatorId   BigInt?    @map("actuator_id")
  eventType    String     @map("event_type")
  message      String
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz
  greenhouse   Greenhouse @relation(fields: [greenhouseId], references: [id], onDelete: Cascade)
  actuator     Actuator?  @relation(fields: [actuatorId], references: [id], onDelete: SetNull)

  @@index([greenhouseId, createdAt(sort: Desc)])
  @@map("event_logs")
}

// 8. Аварійні та інформаційні сповіщення
model Alert {
  id           BigInt     @id @default(autoincrement())
  greenhouseId BigInt     @map("greenhouse_id")
  severity     String     @default("WARNING")
  title        String
  message      String
  isResolved   Boolean    @default(false) @map("is_resolved")
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz
  greenhouse   Greenhouse @relation(fields: [greenhouseId], references: [id], onDelete: Cascade)

  @@map("alerts")
}