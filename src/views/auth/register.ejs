<%- include('../partials/header') %>

<div style="max-width: 480px; margin: 30px auto 0;">
    <article>
        <div style="text-align: center; margin-bottom: 24px;">
            <span style="font-size: 2.5rem;">📝</span>
            <h2 style="margin-top: 8px;">Реєстрація оператора</h2>
            <p style="color: var(--text-muted); font-size: 0.9rem;">Створіть профіль для дистанційного керування</p>
        </div>

        <% if (error) { %>
            <div class="error-banner">
                <%= error %>
            </div>
        <% } %>

        <form action="/auth/register" method="POST">
            <label for="fullName">Прізвище та ім'я</label>
            <input type="text" id="fullName" name="fullName" placeholder="Олександр Петрович" value="<%= formData ? formData.fullName || '' : '' %>" required>

            <label for="email">Електронна пошта</label>
            <input type="email" id="email" name="email" placeholder="operator@greenhouse.local" value="<%= formData ? formData.email || '' : '' %>" required>

            <label for="password">Пароль (від 6 символів)</label>
            <input type="password" id="password" name="password" placeholder="••••••••" required>

            <label for="confirmPassword">Підтвердження пароля</label>
            <input type="password" id="confirmPassword" name="confirmPassword" placeholder="••••••••" required>

            <button type="submit" style="margin-top: 8px;">Зареєструвати теплицю</button>
        </form>

        <div style="text-align: center; margin-top: 20px; font-size: 0.9rem; color: var(--text-muted);">
            Вже маєте обліковий запис? <a href="/auth/login">Увійти</a>
        </div>
    </article>
</div>

<%- include('../partials/footer') %>