<%- include('../partials/header') %>

<div style="max-width: 440px; margin: 40px auto 0;">
    <article>
        <div style="text-align: center; margin-bottom: 24px;">
            <span style="font-size: 2.5rem;">🔐</span>
            <h2 style="margin-top: 8px;">Вхід до системи</h2>
            <p style="color: var(--text-muted); font-size: 0.9rem;">Введіть параметри доступу оператора теплиці</p>
        </div>

        <% if (error) { %>
            <div class="error-banner">
                <%= error %>
            </div>
        <% } %>

        <form action="/auth/login" method="POST">
            <label for="email">Електронна пошта</label>
            <input type="email" id="email" name="email" placeholder="admin@greenhouse.local" required autocomplete="email">

            <label for="password">Пароль</label>
            <input type="password" id="password" name="password" placeholder="••••••••" required autocomplete="current-password">

            <button type="submit" style="margin-top: 8px;">Увійти в кабінет</button>
        </form>

        <div style="text-align: center; margin-top: 20px; font-size: 0.9rem; color: var(--text-muted);">
            Ще не зареєстровані? <a href="/auth/register">Створити обліковий запис</a>
        </div>
    </article>
</div>

<%- include('../partials/footer') %>