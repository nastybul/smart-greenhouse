<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Розумна Теплиця | Система Керування Мікрокліматом</title>

    <!-- Pico.css v2 -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@picocss/pico@2/css/pico.min.css">

    <!-- Власна адаптивна дизайн-система -->
    <link rel="stylesheet" href="/custom.css">
</head>
<body>

<!-- Навігаційна панель -->
<header class="navbar-wrapper">
    <div class="navbar-container">

        <!-- Адаптивний логотип із коректним переносом слів -->
        <a href="/" class="brand-logo">
            <span class="brand-icon">🌱</span>
            <span class="brand-text">
          <span class="brand-word">Розумна</span>
          <span class="brand-word">Теплиця</span>
        </span>
        </a>

        <!-- Кнопка мобільного меню (Бургер) -->
        <button class="burger-btn" id="burgerToggle" aria-label="Відкрити меню" onclick="toggleNav()">
            <span class="burger-line"></span>
            <span class="burger-line"></span>
            <span class="burger-line"></span>
        </button>

        <!-- Меню навігації -->
        <nav id="navbarMenu" class="nav-menu">
            <ul class="nav-links">
                <% if (currentUser) { %>
                    <li><a href="/">Дашборд</a></li>
                    <li><a href="/rules">Автоматика</a></li>
                    <li><a href="/history">Історія та логи</a></li>
                    <li class="user-badge-item">
              <span class="badge badge-active user-badge" title="<%= currentUser.fullName %>">
                👤 <%= currentUser.fullName %>
              </span>
                    </li>
                    <li>
                        <form action="/auth/logout" method="POST" class="logout-form">
                            <button type="submit" class="logout-btn">Вийти</button>
                        </form>
                    </li>
                <% } else { %>
                    <li><a href="/auth/login">Вхід</a></li>
                    <li><a href="/auth/register">Реєстрація</a></li>
                <% } %>
            </ul>
        </nav>

    </div>
</header>

<main class="main-content">

    <script>
        function toggleNav() {
            const menu = document.getElementById('navbarMenu');
            const btn = document.getElementById('burgerToggle');
            menu.classList.toggle('is-open');
            btn.classList.toggle('is-open');
        }
    </script>